#!/bin/sh
# Push guard. The remote whose URL is in the local git config key
# pushguard.giteaUrl accepts any push. Every other remote gets no ref named
# refs/heads/decompiled*, no ref at a tree or blob, and no commit whose history
# or tree holds a .cs or .il file (case-insensitive), and accepts only updates
# of refs/heads/master.

url=$2
gitea=$(git config --get pushguard.giteaUrl 2>/dev/null)
if [ -n "$gitea" ] && [ "$url" = "$gitea" ]; then
    exit 0
fi
# These change how the history test's pathspecs match, or hide real history.
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS
export GIT_NO_REPLACE_OBJECTS=1

status=0

refuse() {
    printf 'pre-push: refusing %s: %s\n' "$1" "$2" >&2
    status=1
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    case $local_sha in *[!0]*) deleting= ;; *) deleting=1 ;; esac
    if [ -z "$deleting" ]; then
        case $remote_ref in
            refs/heads/decompiled*)
                refuse "$remote_ref" "decompiled* branches go only to the pushguard.giteaUrl remote"
                continue ;;
        esac
        if ! commit=$(git rev-parse --verify -q "$local_sha^{commit}" 2>/dev/null); then
            refuse "$remote_ref" "points at a $(git cat-file -t "$local_sha^{}"), not a commit"
            continue
        fi
        if ! found=$(git rev-list --full-history -n 1 "$commit" -- ':(icase)*.cs' ':(icase)*.il'); then
            refuse "$remote_ref" "cannot read the history of $commit"
            continue
        fi
        if [ -n "$found" ]; then
            refuse "$remote_ref" "history holds a .cs or .il file in commit $(git rev-parse --short "$found")"
            continue
        fi
        if ! tree=$(git ls-tree -r --name-only "$local_sha" 2>/dev/null); then
            refuse "$remote_ref" "cannot list the tree of $local_sha"
            continue
        fi
        bad=$(printf '%s\n' "$tree" | grep -E -i -m 1 '\.(cs|il)"?$')
        if [ -n "$bad" ]; then
            refuse "$remote_ref" "tree holds $bad"
            continue
        fi
    fi
    if [ "$remote_ref" != "refs/heads/master" ]; then
        refuse "$remote_ref" "not refs/heads/master"
        continue
    fi
    if [ -n "$deleting" ]; then
        refuse "$remote_ref" "delete"
    fi
done

exit $status
